# Environnement virtuel Python (ne jamais versionner)
venv/
.venv/

# Fichiers Python compilés
__pycache__/
*.pyc

# Fichiers système
.DS_Store
Thumbs.db

# Sorties générées par le pipeline (se régénèrent avec `python -m src.ingest`)
data/processed/*
!data/processed/.gitkeep

# Cache des tests
.pytest_cache/

# Vecteurs générés à l'étape 3 (se régénèrent avec `python -m src.vectorize`)
data/vectors/

# Base vectorielle ChromaDB (se reconstruit avec POST /index)
data/chroma/
